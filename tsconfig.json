{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false
  },
  "include": [
    "index.tsx",
    "playback.tsx",
    "controller.mjs",
    "styles.d.ts"
  ]
}
